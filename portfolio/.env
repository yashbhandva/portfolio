# Server
SERVER_PORT=8080
SPRING_APP_NAME=portfolio-website

# Database - PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/portfolio_db?ssl=false&prepareThreshold=5&preparedStatementCacheQueries=250&preparedStatementCacheSizeMiB=10
DB_USERNAME=postgres
DB_PASSWORD=root

# HikariCP
